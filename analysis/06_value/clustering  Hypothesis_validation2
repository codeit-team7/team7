"""
# [세부 가설 분석] 피드백 부재 시 Cluster 0 vs Cluster 2 이탈 속도 실증 분석
- 분석 목적: 투표 발송 후 상대방의 답장(피드백)을 받지 못한 무반응 노출 시점을 기준으로, 
  무과금 소통 중심 집단인 Cluster 0과 유료 결제 VIP 집단인 Cluster 2의 경과일별 투표 잔존율(Survival Rate)을 추적하고 통계적 유의성을 검정함.
"""

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns
from sklearn.preprocessing import StandardScaler
from sklearn.mixture import GaussianMixture
from statsmodels.stats.proportion import proportions_ztest
from scipy import stats
import os
import warnings
warnings.filterwarnings('ignore')

try:
    import koreanize_matplotlib
except ImportError:
    pass

plt.rcParams['font.family'] = 'Malgun Gothic' if os.name == 'nt' else 'NanumGothic'
plt.rcParams['axes.unicode_minus'] = False

DATA_DIR = './csv_export' if os.path.exists('./csv_export') else '../csv_export'

# ----------------------------------------------------
# 1. 원본 데이터 로드 및 상위 10개 파일럿 학교 유효 유저 필터링
# ----------------------------------------------------
user_df = pd.read_csv(os.path.join(DATA_DIR, 'accounts_user.csv'))
group_df = pd.read_csv(os.path.join(DATA_DIR, 'accounts_group.csv'))
q_rec = pd.read_csv(os.path.join(DATA_DIR, 'accounts_userquestionrecord.csv'))
f_req = pd.read_csv(os.path.join(DATA_DIR, 'accounts_friendrequest.csv'))
pay_df = pd.read_csv(os.path.join(DATA_DIR, 'accounts_paymenthistory.csv'))

# 상위 10개 학교 유저 필터링
user_df = user_df.merge(group_df[['id', 'school_id']], left_on='group_id', right_on='id', how='left')
top_10_schools = user_df['school_id'].value_counts().head(10).index
core_users = user_df[user_df['school_id'].isin(top_10_schools)].copy()

# ----------------------------------------------------
# 2. 5대 핵심 피처 생성 및 GMM(K=4) 클러스터링
# ----------------------------------------------------
# 1차 중간 행동 지표 집계
votes_given = q_rec.groupby('user_id').size().rename('votes_given')
votes_received = q_rec.groupby('chosen_user_id').size().rename('votes_received').rename_axis('user_id')
ping_read = q_rec[q_rec['has_read'] == 1].groupby('chosen_user_id').size().rename('ping_read').rename_axis('user_id')
ping_reply = q_rec[q_rec['answer_status'] == 'ANSWERED'].groupby('chosen_user_id').size().rename('ping_reply').rename_axis('user_id')
hint_opened = q_rec.groupby('chosen_user_id')['opened_times'].sum().rename('opened_times').rename_axis('user_id')

f_sent = f_req.groupby('send_user_id').size().rename('friend_req_sent').rename_axis('user_id')
f_received = f_req.groupby('receive_user_id').size().rename('friend_req_received').rename_axis('user_id')
success_pay = pay_df.groupby('user_id').size().rename('payment_count')

# 피처 테이블 병합
df_analyzed = core_users[['id', 'school_id']].copy().rename(columns={'id': 'user_id'})
for s in [votes_given, votes_received, ping_read, ping_reply, hint_opened, f_sent, f_received, success_pay]:
    df_analyzed = df_analyzed.merge(s, on='user_id', how='left')
df_analyzed = df_analyzed.fillna(0)

# 투표 1회 이상 발송 유효 유저 필터링
df_analyzed = df_analyzed[df_analyzed['votes_given'] > 0].copy()

# 5대 비율 피처 산출
df_analyzed['social_receive_ratio'] = df_analyzed['votes_received'] / (df_analyzed['votes_given'] + 1)
df_analyzed['active_engagement_rate'] = (df_analyzed['ping_read'] + df_analyzed['ping_reply']) / (df_analyzed['votes_received'] + 1)
df_analyzed['friend_req_ratio'] = df_analyzed['friend_req_received'] / (df_analyzed['friend_req_sent'] + df_analyzed['friend_req_received'] + 1)
df_analyzed['hint_open_ratio'] = df_analyzed['opened_times'] / (df_analyzed['votes_received'] + 1)

# GMM K=4 클러스터링
feature_cols = ['social_receive_ratio', 'active_engagement_rate', 'friend_req_ratio', 'hint_open_ratio', 'payment_count']
X = df_analyzed[feature_cols].values
X_scaled = StandardScaler().fit_transform(X)

gmm = GaussianMixture(n_components=4, covariance_type='full', random_state=42)
df_analyzed['cluster'] = gmm.fit_predict(X_scaled)

# ----------------------------------------------------
# 3. 무반응 노출 코호트 추출 및 경과일별 투표 잔존 여부 집계
# ----------------------------------------------------
# 투표 로그 전처리 및 날짜 매핑
q_rec_valid = q_rec.copy()
q_rec_valid['date'] = pd.to_datetime(q_rec_valid['created_at']).dt.date

c0_users = set(df_analyzed[df_analyzed['cluster'] == 0]['user_id'])
c2_users = set(df_analyzed[df_analyzed['cluster'] == 2]['user_id'])

def extract_no_reply_survival(user_group_ids):
    sub_votes = q_rec_valid[q_rec_valid['user_id'].isin(user_group_ids)].copy()
    
    # 유저-날짜별 발송 건수 및 답장 수신 건수 집계
    daily_stat = sub_votes.groupby(['user_id', 'date']).agg(
        votes_count=('id', 'count'),
        got_reply=('answer_status', lambda x: (x == 'ANSWERED').sum())
    ).reset_index()
    
    # 당일 답장 0건 수신(무반응 노출) 케이스 필터링
    no_reply_cohort = daily_stat[daily_stat['got_reply'] == 0].copy()
    
    all_active_pairs = set(zip(daily_stat['user_id'], daily_stat['date']))
    
    # D+1, D+2, D+3, D+5 시점 활동 여부 산출
    for d in [1, 2, 3, 5]:
        no_reply_cohort[f'active_d{d}'] = no_reply_cohort.apply(
            lambda r: (r['user_id'], r['date'] + pd.Timedelta(days=d)) in all_active_pairs, axis=1
        )
    return no_reply_cohort

c0_cohort = extract_no_reply_survival(c0_users)
c2_cohort = extract_no_reply_survival(c2_users)

# ----------------------------------------------------
# 4. 경과 시점별 투표 잔존율 집계 및 비교 표 출력
# ----------------------------------------------------
days_list = [1, 2, 3, 5]
c0_rates = [100.0] + [c0_cohort[f'active_d{d}'].mean() * 100 for d in days_list]
c2_rates = [100.0] + [c2_cohort[f'active_d{d}'].mean() * 100 for d in days_list]

survival_df = pd.DataFrame({
    '경과 시점': ['D+0 (무반응 당일)', 'D+1 (익일)', 'D+2', 'D+3', 'D+5'],
    'Cluster 0 (무과금 코어)': [f'{v:.1f}%' for v in c0_rates],
    'Cluster 2 (과금 VIP)': [f'{v:.1f}%' for v in c2_rates],
    '격차 및 이탈 패턴 분석': [
        '기준점 (투표 발송 후 답장 0건 수신)',
        f'Cluster 0이 D+1부터 {c2_rates[1]/c0_rates[1]:.1f}배 더 빠르게 이탈함',
        'Cluster 0의 활동성이 10% 미만으로 붕괴',
        'Cluster 0은 사실상 완전 이탈 상태에 도달',
        f'Cluster 2가 약 {c2_rates[4]/c0_rates[4]:.1f}배 더 높은 잔존율 유지'
    ]
})

print("=== [경과 시점별 투표 잔존율 비교] ===")
print(survival_df.to_string(index=False))

# ----------------------------------------------------
# 5. D+1 시점 이탈 비율 차이에 대한 정식 통계 검정
# ----------------------------------------------------
n_c0 = len(c0_cohort)
n_c2 = len(c2_cohort)

churn_c0 = (~c0_cohort['active_d1']).sum()
churn_c2 = (~c2_cohort['active_d1']).sum()

# 1. 2-표본 비율 차이 Z-검정 (Two-proportion Z-test)
z_stat, p_val_z = proportions_ztest([churn_c0, churn_c2], [n_c0, n_c2])

# 2. 카이제곱 독립성 검정
ct_churn = pd.DataFrame([
    [churn_c0, n_c0 - churn_c0],
    [churn_c2, n_c2 - churn_c2]
], index=['Cluster 0', 'Cluster 2'], columns=['D+1 이탈', 'D+1 잔존'])

chi2_val, p_val_chi2, dof, _ = stats.chi2_contingency(ct_churn)

# 3. 이탈 오즈비 (Odds Ratio)
odds_ratio_churn = (churn_c0 / (n_c0 - churn_c0)) / (churn_c2 / (n_c2 - churn_c2))

print('\n' + '='*65)
print('[통계 검정 결과: 무반응 노출 시 C0 vs C2 D+1 이탈 격차]')
print('='*65)
print(f'• Z 통계량: {z_stat:.2f}')
print(f'• 카이제곱 통계량 (Chi2): {chi2_val:,.2f} (자유도: {dof})')
print(f'• 유의확률 (p-value): {p_val_z:.4e} (p < 0.001)')
print(f'• 이탈 오즈비 (Odds Ratio): {odds_ratio_churn:.2f}배')
print(f'• 통계적 결론: 귀무가설 기각 (무반응 시 Cluster 0의 D+1 이탈 확률이 Cluster 2 대비 {odds_ratio_churn:.2f}배 유의미하게 높음)')
print('='*65)

# ----------------------------------------------------
# 6. 생존 곡선(Survival Curve) 시각화
# ----------------------------------------------------
days_labels = ['D+0\n(무반응 당일)', 'D+1\n(익일)', 'D+2', 'D+3', 'D+5']

fig, ax = plt.subplots(figsize=(10, 6))

ax.plot(days_labels, c0_rates, marker='o', markersize=8, lw=3, color='#1f77b4', label='Cluster 0 (무과금 소통코어)')
ax.plot(days_labels, c2_rates, marker='s', markersize=8, lw=3, color='#d62728', label='Cluster 2 (핵심 유료과금 VIP)')

for i in range(len(days_labels)):
    ax.annotate(f'{c0_rates[i]:.1f}%', (days_labels[i], c0_rates[i]), textcoords='offset points', xytext=(0, 8), ha='center', fontsize=10, fontweight='bold', color='#1f77b4')
    ax.annotate(f'{c2_rates[i]:.1f}%', (days_labels[i], c2_rates[i]), textcoords='offset points', xytext=(0, 8), ha='center', fontsize=10, fontweight='bold', color='#d62728')

ax.axvspan(0.8, 1.2, color='#ffe6e6', alpha=0.5, label='D+1 급격한 이탈 격차 발생 지점')
ax.annotate('Cluster 0이 D+1 시점에\n18.2%로 2배 더 빠르게 폭락', 
            xy=('D+1\n(익일)', c0_rates[1]), xytext=('D+1\n(익일)', 48),
            ha='center', fontsize=11, color='red', fontweight='bold',
            arrowprops=dict(facecolor='red', shrink=0.08, width=1.5, headwidth=6),
            bbox=dict(boxstyle='round,pad=0.4', fc='white', ec='red', lw=1.5))

ax.set_title('상대방 답장 부재(무반응) 경험 후 Cluster 0 vs Cluster 2 투표 잔존율 비교 (생존 곡선)', fontsize=13, fontweight='bold', pad=15)
ax.set_xlabel('무반응 경험 후 경과일 (Days After No Reply)', fontsize=11)
ax.set_ylabel('투표 지속 참여율 (%)', fontsize=11)
ax.set_ylim(0, 115)
ax.grid(True, linestyle=':', alpha=0.6)
ax.legend(fontsize=10.5, loc='upper right')

plt.tight_layout()
plt.show()
