file_path_fr = os.path.join(MART_DIR, 'mart_user_viral_profile_v2.csv.gz')
df_fr = pd.read_csv(file_path_fr, usecols=['user_id', 'sent_request_count', 'received_request_count'])

sent = df_fr['sent_request_count'].fillna(0)
recv = df_fr['received_request_count'].fillna(0)
tot = sent + recv

df_act = df_fr[tot > 0].copy()
total_act_fr = len(df_act)

sent_bins = [-1, 0, 2, 5, 15, 30, np.inf]
sent_labels = ['0회', '1~2회', '3~5회', '6~15회', '16~30회', '31회+']
