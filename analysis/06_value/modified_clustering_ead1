recv_bins = [-1, 0, 2, 5, 15, 30, np.inf]
recv_labels = ['0회', '1~2회', '3~5회', '6~15회', '16~30회', '31회+']
df_act['recv_tier'] = pd.cut(df_act['received_request_count'].fillna(0), bins=recv_bins, labels=recv_labels)

df_act['popularity_ratio'] = df_act['received_request_count'].fillna(0) / (df_act['sent_request_count'].fillna(0) + df_act['received_request_count'].fillna(0) + 1)
