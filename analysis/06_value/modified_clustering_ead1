axes[0].set_title('친구 요청 발송 수 구간', fontsize=11, weight='bold', pad=10)
axes[0].set_xlabel('sent_tier', fontsize=10, labelpad=8)
axes[0].set_ylim(0, max(s_counts) * 1.15)
axes[0].tick_params(axis='x', rotation=30)
axes[0].grid(axis='y', linestyle='-', alpha=0.3, color='#cccccc')
