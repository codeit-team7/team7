                     ha='center', va='bottom', fontsize=7.5, xytext=(0, 2), textcoords='offset points')

# Subplot 2
c_counts = qs_grouped['completed_tier'].value_counts().reindex(c_labels, fill_value=0)
bars2 = axes[1].bar(c_labels, c_counts, color=palette_teal, width=0.7)
axes[1].set_title('투표 세트 완주 수 구간', fontsize=11, weight='bold', pad=10)
axes[1].set_xlabel('completed_tier', fontsize=10, labelpad=8)
