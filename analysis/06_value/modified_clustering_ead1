# ----------------------------------------------------
# 2. polls_questionset : 투표 세트 코어 활동 구간 분포
# ----------------------------------------------------
print("\n" + "="*70)
print("2. polls_questionset : 투표 세트 코어 활동 구간 분포 분석")
print("="*70)

file_path_qs = os.path.join(MART_DIR, 'mart_question_set_record_v2.csv.gz')
df_qs_all = pd.read_csv(file_path_qs, usecols=['question_set_id', 'question_set_owner_user_id', 'question_set_status'])

qs_grouped = df_qs_all.groupby('question_set_owner_user_id').agg(
    started=('question_set_id', 'count'),
    completed=('question_set_status', lambda s: (s == 'F').sum())
).reset_index()

total_qs_users = len(qs_grouped)
qs_grouped['rate'] = qs_grouped['completed'] / qs_grouped['started'] * 100

s_bins = [0, 1, 5, 15, 40, 80, np.inf]
s_labels = ['1회(찍먹)', '2~5회', '6~15회', '16~40회', '41~80회', '81회+(헤비)']
qs_grouped['started_tier'] = pd.cut(qs_grouped['started'], bins=s_bins, labels=s_labels)

c_bins = [0, 1, 5, 15, 40, 80, np.inf]
c_labels = ['1회(찍먹)', '2~5회', '6~15회', '16~40회', '41~80회', '81회+(헤비)']
qs_grouped['completed_tier'] = pd.cut(qs_grouped['completed'], bins=c_bins, labels=c_labels)

def get_rate_tier(r):
    if r == 0:
        return '0%(완주실패)'
    elif r <= 50:
        return '1~50%'
    elif r <= 80:
        return '51~80%'
    elif r < 100:
        return '81~99%'
    else:
        return '100%(전부완주)'

r_labels = ['0%(완주실패)', '1~50%', '51~80%', '81~99%', '100%(전부완주)']
qs_grouped['rate_tier'] = qs_grouped['rate'].map(get_rate_tier)

