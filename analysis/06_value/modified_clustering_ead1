palette_orange = ['#8c2d04', '#c94d12', '#e67329', '#f39e58', '#f8c495', '#fde2cb']
palette_purple = ['#4a2b66', '#6b4c8a', '#9173b0', '#bca3d4', '#e2d7ed']

# Subplot 1
s_counts = df_act['sent_tier'].value_counts().reindex(sent_labels, fill_value=0)
