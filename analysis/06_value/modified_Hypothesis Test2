"""
========================================================================================
[7단계 팀원 데이터마트 종합 실증분석]
피드백 부재(무반응) 시 Cluster 0 vs Cluster 2 투표 잔존/이탈 실증 분석
- 데이터 소스: 
  * GMM 세그먼트 마트: mart_clustering_gmm_results_top10_datamart.csv
  * 투표 로그 마트: mart_vote_record_v2.csv.gz
- 분석 내용: 무반응 노출 시 무과금 소통 집단(C0)과 핵심 과금 VIP 집단(C2)의 
             D+0 ~ D+5 경과일별 생존율(Survival Rate) 및 D+1 이탈 통계 검정
========================================================================================
"""

import os
import sys
import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns
from scipy import stats
from statsmodels.stats.proportion import proportions_ztest

# -----------------------------------------------------------------------------
# 1. 환경 설정 및 한글 폰트 세팅
# -----------------------------------------------------------------------------
plt.rc('font', family='Malgun Gothic')
plt.rcParams['axes.unicode_minus'] = False

BASE_DIR = r"c:\Users\user\Desktop\고급프로젝트"
DATA_DIR = os.path.join(BASE_DIR, "기존 5개 + 신규 18개 마트 최종(압축 csv 형식)-20260917T001059Z-1-001", "기존 5개 + 신규 18개 마트 최종(압축 csv 형식)")
OUTPUT_DIR = os.path.join(BASE_DIR, "데이터마트_기반_클러스터링_EDA")
os.makedirs(OUTPUT_DIR, exist_ok=True)

print("=" * 80)
print("[Step 7 팀원 데이터마트 파이프라인] C0 vs C2 무반응 이탈 실증분석 시작")
print("=" * 80)

# -----------------------------------------------------------------------------
# 2. 데이터 로드 및 클러스터 유저 매핑
# -----------------------------------------------------------------------------
gmm_path = os.path.join(OUTPUT_DIR, "mart_clustering_gmm_results_top10_datamart.csv")
vote_path = os.path.join(DATA_DIR, "mart_vote_record_v2.csv.gz")

print(f"- 1. GMM 클러스터링 결과 로드: {gmm_path}")
gmm_df = pd.read_csv(gmm_path)

c0_users = set(gmm_df[gmm_df['cluster'] == 0]['user_id'])
c1_users = set(gmm_df[gmm_df['cluster'] == 1]['user_id'])
c2_users = set(gmm_df[gmm_df['cluster'] == 2]['user_id'])
c3_users = set(gmm_df[gmm_df['cluster'] == 3]['user_id'])

print(f"  * Cluster 0 (무과금 소통코어): {len(c0_users):,}명")
print(f"  * Cluster 1 (인기 수혜층): {len(c1_users):,}명")
print(f"  * Cluster 2 (핵심 유료과금 VIP): {len(c2_users):,}명")
print(f"  * Cluster 3 (극단적 침묵층): {len(c3_users):,}명")

print(f"- 2. 투표 로그 데이터마트 로드: {vote_path}")
vr = pd.read_csv(vote_path)
vr['date'] = pd.to_datetime(vr['vote_record_created_at']).dt.date
print(f"  * 총 투표 로그 레코드 수: {len(vr):,}건")

# -----------------------------------------------------------------------------
# 3. 유저-일자별 투표 발송 및 피드백 수신 집계
# -----------------------------------------------------------------------------
print("- 3. 유저-일자별 투표 활동 및 피드백 수신 집계 중...")
daily_stat = vr.groupby(['voter_user_id', 'date']).agg(
    votes_count=('user_question_record_id', 'count'),
    got_reply=('ping_answer_status_current', lambda x: (x == 'A').sum())
).reset_index().rename(columns={'voter_user_id': 'user_id'})

all_active_pairs = set(zip(daily_stat['user_id'], daily_stat['date']))

def extract_cohort_survival(user_set):
    sub = daily_stat[daily_stat['user_id'].isin(user_set)].copy()
    no_reply = sub[sub['got_reply'] == 0].copy()
    reply = sub[sub['got_reply'] > 0].copy()
    
    days_to_track = [1, 2, 3, 4, 5, 7]
    for d in days_to_track:
        no_reply[f'active_d{d}'] = no_reply.apply(
            lambda r: (r['user_id'], r['date'] + pd.Timedelta(days=d)) in all_active_pairs, axis=1
        )
        reply[f'active_d{d}'] = reply.apply(
            lambda r: (r['user_id'], r['date'] + pd.Timedelta(days=d)) in all_active_pairs, axis=1
        )
    return no_reply, reply

c0_no_reply, c0_reply = extract_cohort_survival(c0_users)
c2_no_reply, c2_reply = extract_cohort_survival(c2_users)

print(f"  * 무반응 노출 코호트 케이스 수: Cluster 0 = {len(c0_no_reply):,}건, Cluster 2 = {len(c2_no_reply):,}건")

# -----------------------------------------------------------------------------
# 4. 경과일별 투표 잔존율 집계
# -----------------------------------------------------------------------------
days_list = [1, 2, 3, 5]
days_labels = ['D+0 (무반응 당일)', 'D+1 (익일)', 'D+2', 'D+3', 'D+5']

c0_rates = [100.0] + [c0_no_reply[f'active_d{d}'].mean() * 100 for d in days_list]
c2_rates = [100.0] + [c2_no_reply[f'active_d{d}'].mean() * 100 for d in days_list]

c0_rep_rates = [100.0] + [c0_reply[f'active_d{d}'].mean() * 100 for d in days_list]
c2_rep_rates = [100.0] + [c2_reply[f'active_d{d}'].mean() * 100 for d in days_list]

survival_df = pd.DataFrame({
    '경과 시점': days_labels,
    'Cluster 0 (무과금 코어)': [f"{v:.1f}%" for v in c0_rates],
    'Cluster 2 (과금 VIP)': [f"{v:.1f}%" for v in c2_rates],
    '격차 및 패턴 분석': [
        '기준점 (투표 발송 후 답장 0건 수신)',
        f'무반응 시 D+1 잔존율 C0 {c0_rates[1]:.1f}% vs C2 {c2_rates[1]:.1f}%',
        f'C0 잔존율 {c0_rates[2]:.1f}%로 급감',
        f'C0 잔존율 {c0_rates[3]:.1f}% 지속 하락',
        f'D+5 장기 잔존율 C0 {c0_rates[4]:.1f}% vs C2 {c2_rates[4]:.1f}%'
    ]
})

print("\n" + "=" * 80)
print("[표 1] 무반응 노출 후 경과일별 투표 잔존율 (데이터마트 기반)")
print("=" * 80)
print(survival_df.to_string(index=False))

# -----------------------------------------------------------------------------
# 5. 정식 통계 가설 검정
# -----------------------------------------------------------------------------
n_c0 = len(c0_no_reply)
n_c2 = len(c2_no_reply)

churn_c0 = (~c0_no_reply['active_d1']).sum()
churn_c2 = (~c2_no_reply['active_d1']).sum()

z_stat, p_val_z = proportions_ztest([churn_c0, churn_c2], [n_c0, n_c2])

contingency_table = pd.DataFrame([
    [churn_c0, n_c0 - churn_c0],
    [churn_c2, n_c2 - churn_c2]
], index=['Cluster 0', 'Cluster 2'], columns=['D+1 이탈', 'D+1 잔존'])

chi2_val, p_val_chi2, dof, _ = stats.chi2_contingency(contingency_table)
odds_ratio_churn = (churn_c0 / (n_c0 - churn_c0)) / (churn_c2 / (n_c2 - churn_c2))

print("\n" + "=" * 80)
print("[정식 통계 검정 결과: 무반응 노출 시 D+1 이탈 격차 (데이터마트 기반)]")
print("=" * 80)
print(f"- Cluster 0 코호트: N = {n_c0:,}건 (D+1 이탈: {churn_c0:,}건, {churn_c0/n_c0*100:.1f}%)")
print(f"- Cluster 2 코호트: N = {n_c2:,}건 (D+1 이탈: {churn_c2:,}건, {churn_c2/n_c2*100:.1f}%)")
print(f"- 2-표본 Z 통계량: {z_stat:.4f} (p-value: {p_val_z:.4e})")
print(f"- 카이제곱 통계량 (Chi2): {chi2_val:,.4f} (자유도: {dof}, p-value: {p_val_chi2:.4e})")
print(f"- 이탈 오즈비 (Odds Ratio): {odds_ratio_churn:.4f}배")
print("=" * 80)

# -----------------------------------------------------------------------------
# 6. 시각화 대시보드 저장
# -----------------------------------------------------------------------------
fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(16, 6))

x_ticks = [0, 1, 2, 3, 4]
x_labels = ['D+0\n(무반응 당일)', 'D+1\n(익일)', 'D+2', 'D+3', 'D+5']

ax1.plot(x_ticks, c0_rates, marker='o', markersize=9, lw=3, color='#1f77b4', label=f'Cluster 0 (무과금 소통코어 / {len(c0_users):,}명)')
ax1.plot(x_ticks, c2_rates, marker='s', markersize=9, lw=3, color='#d62728', label=f'Cluster 2 (핵심 유료과금 VIP / {len(c2_users):,}명)')

for i, (r0, r2) in enumerate(zip(c0_rates, c2_rates)):
    ax1.annotate(f'{r0:.1f}%', (x_ticks[i], r0), textcoords='offset points', xytext=(0, 10),
                 ha='center', fontsize=10.5, fontweight='bold', color='#1f77b4')
    ax1.annotate(f'{r2:.1f}%', (x_ticks[i], r2), textcoords='offset points', xytext=(0, -16),
                 ha='center', fontsize=10.5, fontweight='bold', color='#d62728')

ax1.axvspan(0.7, 1.3, color='#ffe6e6', alpha=0.5, label='D+1 초기 이탈 급락 구간')
ax1.annotate(f'무반응 시 D+1 잔존율\nC0: {c0_rates[1]:.1f}% | C2: {c2_rates[1]:.1f}%\n(Z={z_stat:.2f}, p<0.05)',
             xy=(1, c0_rates[1]), xytext=(1, 75),
             ha='center', fontsize=10.5, color='darkred', fontweight='bold',
             arrowprops=dict(facecolor='red', shrink=0.08, width=1.5, headwidth=6),
             bbox=dict(boxstyle='round,pad=0.5', fc='white', ec='red', lw=1.5))

ax1.set_title('[가설 실증] 무반응(답장 0건) 경험 후 경과일별 투표 잔존율 (생존 곡선)', fontsize=13, fontweight='bold', pad=12)
ax1.set_xlabel('무반응 경험 후 경과일 (Days After No Reply)', fontsize=11, fontweight='bold')
ax1.set_ylabel('투표 지속 참여율 (%)', fontsize=11, fontweight='bold')
ax1.set_xticks(x_ticks)
ax1.set_xticklabels(x_labels, fontsize=10)
ax1.set_ylim(20, 110)
ax1.grid(True, linestyle=':', alpha=0.6)
ax1.legend(fontsize=10, loc='upper right')

# Panel 2: Interaction
feedback_comp_df = pd.DataFrame({
    '군집': ['Cluster 0\n(소통코어)', 'Cluster 0\n(소통코어)', 'Cluster 2\n(과금VIP)', 'Cluster 2\n(과금VIP)'],
    '피드백 상태': ['답장 수신 (피드백 O)', '답장 미수신 (무반응)', '답장 수신 (피드백 O)', '답장 미수신 (무반응)'],
    'D+1 잔존율 (%)': [c0_rep_rates[1], c0_rates[1], c2_rep_rates[1], c2_rates[1]]
})

sns.barplot(data=feedback_comp_df, x='군집', y='D+1 잔존율 (%)', hue='피드백 상태',
            palette=['#2ca02c', '#d62728'], ax=ax2, edgecolor='black', alpha=0.85)

for p in ax2.patches:
    height = p.get_height()
    if height > 0:
        ax2.annotate(f'{height:.1f}%',
                     (p.get_x() + p.get_width() / 2., height / 2),
                     ha='center', va='center', fontsize=11, color='white', fontweight='bold')

drop_c0 = c0_rep_rates[1] - c0_rates[1]
drop_c2 = c2_rep_rates[1] - c2_rates[1]

ax2.set_title('[심층 비교] 피드백 수신 여부에 따른 D+1 투표 잔존율 급락 폭', fontsize=13, fontweight='bold', pad=12)
ax2.set_ylabel('D+1 투표 잔존율 (%)', fontsize=11, fontweight='bold')
ax2.set_xlabel('유저 세그먼트', fontsize=11, fontweight='bold')
ax2.set_ylim(0, 100)
ax2.grid(True, linestyle=':', alpha=0.6, axis='y')
ax2.legend(fontsize=10.5, loc='upper right')

ax2.text(0, c0_rep_rates[1] + 3, f'피드백 부재 시\n-{drop_c0:.1f}%p 폭락', ha='center', color='red', fontweight='bold', fontsize=10)
ax2.text(1, c2_rep_rates[1] + 3, f'피드백 부재 시\n-{drop_c2:.1f}%p 폭락', ha='center', color='red', fontweight='bold', fontsize=10)

plt.tight_layout()
chart_path = os.path.join(OUTPUT_DIR, "7단계_c0_vs_c2_무반응_생존곡선.png")
plt.savefig(chart_path, dpi=300)
plt.close()
print(f"\n- 시각화 차트 저장 완료: {chart_path}")

print("=" * 80)
print("[Step 7 팀원 데이터마트 파이프라인] 실증 분석 완료")
print("=" * 80)
