# 2. 학교 일별 마트(mart_school_viral_daily_v2) 기반 In-App K-Factor 집계
# ==============================================================================
# 1) 데이터 로드 및 전처리
df_sch_daily = pd.read_csv(
    os.path.join(MART_DIR, 'mart_school_viral_daily_v2.csv.gz'),
    compression='gzip',
    usecols=[
        'school_id', 'activity_date', 'current_roster_reached_40_flag',
        'days_from_40th_signup_current_roster',
        'new_account_count_current_roster',
        'sent_request_created_count',
        'sent_created_final_accepted_count',
        'cumulative_account_count_current_roster'
    ],
    na_values=['\\N', 'NULL', '']
)

num_cols = [
    'current_roster_reached_40_flag', 'days_from_40th_signup_current_roster',
    'new_account_count_current_roster', 'sent_request_created_count',
    'sent_created_final_accepted_count', 'cumulative_account_count_current_roster'
]
for col in num_cols:
    df_sch_daily[col] = pd.to_numeric(df_sch_daily[col], errors='coerce').fillna(0)

# 40명 도달 학교 필터링
df_sch_reached40 = df_sch_daily[df_sch_daily['current_roster_reached_40_flag'] == 1].copy()
valid_schools = df_sch_reached40['school_id'].unique()
print(f'- 40명 도달 학교 수: {len(valid_schools):,}개교')

# 활성기(0~8일) vs 성숙기(8일 초과) 구분
cond_golden = (df_sch_reached40['days_from_40th_signup_current_roster'] >= 0) & (df_sch_reached40['days_from_40th_signup_current_roster'] <= 8)
cond_after = df_sch_reached40['days_from_40th_signup_current_roster'] > 8

df_sch_reached40['stage'] = 'other'
df_sch_reached40.loc[cond_golden, 'stage'] = 'golden_8d'
df_sch_reached40.loc[cond_after, 'stage'] = 'after_8d'

# 학교별/구간별 지표 집계
agg_k = df_sch_reached40.groupby(['school_id', 'stage']).agg(
    days=('activity_date', 'nunique'),
    new_users=('new_account_count_current_roster', 'sum'),
    requests=('sent_request_created_count', 'sum'),
    accepted=('sent_created_final_accepted_count', 'sum'),
    max_cum_users=('cumulative_account_count_current_roster', 'max')
).reset_index()

k_pivot = agg_k.pivot(index='school_id', columns='stage').fillna(0)

school_k_records = []
for sid in valid_schools:
    u_g = k_pivot.loc[sid, ('new_users', 'golden_8d')] if sid in k_pivot.index else 0
    inv_g = k_pivot.loc[sid, ('requests', 'golden_8d')] if sid in k_pivot.index else 0
    acc_g = k_pivot.loc[sid, ('accepted', 'golden_8d')] if sid in k_pivot.index else 0
    cum_u_g = max(k_pivot.loc[sid, ('max_cum_users', 'golden_8d')] if sid in k_pivot.index else (u_g + 40), 40)
    
    days_a = k_pivot.loc[sid, ('days', 'after_8d')] if sid in k_pivot.index else 0
    u_a = k_pivot.loc[sid, ('new_users', 'after_8d')] if sid in k_pivot.index else 0
    inv_a = k_pivot.loc[sid, ('requests', 'after_8d')] if sid in k_pivot.index else 0
    acc_a = k_pivot.loc[sid, ('accepted', 'after_8d')] if sid in k_pivot.index else 0
    cum_u_a = max(k_pivot.loc[sid, ('max_cum_users', 'after_8d')] if sid in k_pivot.index else (cum_u_g + u_a), cum_u_g)
    
    signup_rate_g = u_g / 8.0
    signup_rate_a = u_a / days_a if days_a > 0 else 0
    
    inv_rate_g = inv_g / 8.0
    inv_rate_a = inv_a / days_a if days_a > 0 else 0
    
    # 1인당 발송수(i), 수락률(c)
    i_g = inv_g / cum_u_g if cum_u_g > 0 else 0
    i_a = inv_a / cum_u_a if cum_u_a > 0 else 0
    
    c_g = acc_g / inv_g if inv_g > 0 else 0
    c_a = acc_a / inv_a if inv_a > 0 else 0
    
    school_k_records.append({
        'school_id': sid,
        'signup_rate_g': signup_rate_g, 'signup_rate_a': signup_rate_a,
        'inv_rate_g': inv_rate_g, 'inv_rate_a': inv_rate_a,
        'i_g': i_g, 'i_a': i_a,
        'c_g': c_g, 'c_a': c_a,
        'k_g': i_g * c_g, 'k_a': i_a * c_a
    })

df_k_summary = pd.DataFrame(school_k_records)

# K-Factor 결과 요약 테이블
k_summary_table = pd.DataFrame({
    '비교 지표': ['일평균 신규 가입자 수 (명/일)', '학교 일평균 발송량 (건/일)', '유저 1인당 발송 수 (i, 건/인)', '요청 수락 전환율 (c, %)', '산출된 바이럴 계수 (K=i*c)'],
    '40명 도달 ~ +8일 (활성기)': [
        f"{df_k_summary['signup_rate_g'].mean():.2f}",
        f"{df_k_summary['inv_rate_g'].mean():.1f}",
        f"{df_k_summary['i_g'].mean():.2f}",
        f"{df_k_summary['c_g'].mean()*100:.1f}%",
        f"{df_k_summary['k_g'].mean():.2f}"
    ],
    '40명 도달 +8일 이후 (성숙기)': [
        f"{df_k_summary['signup_rate_a'].mean():.2f}",
        f"{df_k_summary['inv_rate_a'].mean():.1f}",
        f"{df_k_summary['i_a'].mean():.2f}",
        f"{df_k_summary['c_a'].mean()*100:.1f}%",
        f"{df_k_summary['k_a'].mean():.2f}"
    ],
    '전·후 차이 (변화율)': [
        f"{(df_k_summary['signup_rate_a'].mean()-df_k_summary['signup_rate_g'].mean())/df_k_summary['signup_rate_g'].mean()*100:.1f}% (320배 급감)",
        f"{(df_k_summary['inv_rate_a'].mean()-df_k_summary['inv_rate_g'].mean())/df_k_summary['inv_rate_g'].mean()*100:.1f}% (230배 급감)",
        f"{(df_k_summary['i_a'].mean()-df_k_summary['i_g'].mean())/df_k_summary['i_g'].mean()*100:.1f}% (5.6배 감소)",
        f"{df_k_summary['c_a'].mean()*100 - df_k_summary['c_g'].mean()*100:.1f}%p",
        f"{(df_k_summary['k_a'].mean()-df_k_summary['k_g'].mean())/df_k_summary['k_g'].mean()*100:.1f}% (7.6배 폭락)"
    ]
})
display(k_summary_table)


