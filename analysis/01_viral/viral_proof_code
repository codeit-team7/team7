# 3. 친구요청 이벤트 마트(mart_friend_request_event_v2) 기반 Viral Cycle Time 집계
# ==============================================================================
# 유저별 40명 도달 시점 매핑 정보 추출
user_acq = pd.read_csv(
    os.path.join(MART_DIR, 'mart_user_acquisition_profile_v2.csv.gz'),
    compression='gzip',
    usecols=['user_id', 'current_roster_40th_signup_at', 'current_roster_reached_40_flag'],
    na_values=['\\N', 'NULL', '']
)
user_acq = user_acq[user_acq['current_roster_reached_40_flag'] == 1].copy()
user_acq['t40'] = pd.to_datetime(user_acq['current_roster_40th_signup_at'])
user_acq['t40_plus8'] = user_acq['t40'] + pd.to_timedelta(8, unit='D')
user_timing_map = user_acq.set_index('user_id')[['t40', 't40_plus8']].to_dict('index')

golden_cycle_hours = []
after_cycle_hours = []
CHUNK_SIZE = 2000000

# 스트리밍 청크 단위로 수락 소요 시간 집계
for chunk in pd.read_csv(
    os.path.join(MART_DIR, 'mart_friend_request_event_v2.csv.gz'),
    compression='gzip',
    usecols=['send_user_id', 'final_status_code', 'request_created_at_raw', 'created_to_last_update_seconds', 'negative_update_interval_flag'],
    chunksize=CHUNK_SIZE,
    na_values=['\\N', 'NULL', '']
):
    chunk['created_to_last_update_seconds'] = pd.to_numeric(chunk['created_to_last_update_seconds'], errors='coerce').fillna(0)
    chunk['negative_update_interval_flag'] = pd.to_numeric(chunk['negative_update_interval_flag'], errors='coerce').fillna(0)
    
    # 정상 수락 건 필터링 (A: 수락, 음수 인터벌 제외)
    acc = chunk[(chunk['final_status_code'] == 'A') & (chunk['negative_update_interval_flag'] == 0)].copy()
    if acc.empty:
        continue
    
    acc['hours'] = acc['created_to_last_update_seconds'] / 3600.0
    acc['req_at'] = pd.to_datetime(acc['request_created_at_raw'])
    
    matched_u = acc['send_user_id'].map(user_timing_map)
    valid_mask = matched_u.notna()
    acc_v = acc[valid_mask].copy()
    
    if not acc_v.empty:
        u_info = matched_u[valid_mask]
        t40_series = pd.Series([x['t40'] for x in u_info], index=acc_v.index)
        t40_8_series = pd.Series([x['t40_plus8'] for x in u_info], index=acc_v.index)
        
        cond_g = (acc_v['req_at'] >= t40_series) & (acc_v['req_at'] <= t40_8_series)
        cond_a = acc_v['req_at'] > t40_8_series
        
        golden_cycle_hours.append(acc_v.loc[cond_g, 'hours'].values)
        after_cycle_hours.append(acc_v.loc[cond_a, 'hours'].values)

arr_golden_c = np.concatenate(golden_cycle_hours)
arr_after_c = np.concatenate(after_cycle_hours)

def get_stats(arr):
    mean_h = np.mean(arr)
    median_h = np.median(arr)
    p24 = np.mean(arr <= 24.0) * 100
    p3 = np.mean(arr <= 3.0) * 100
    return mean_h, mean_h/24.0, median_h, median_h/24.0, p24, p3

g_mean_h, g_mean_d, g_med_h, g_med_d, g_p24, g_p3 = get_stats(arr_golden_c)
a_mean_h, a_mean_d, a_med_h, a_med_d, a_p24, a_p3 = get_stats(arr_after_c)

# Cycle Time 결과 요약 테이블
cycle_summary_table = pd.DataFrame({
    '구분': ['평균 소요 시간', '중앙값 (Median)', '24시간(1일) 이내 완료율', '3시간 이내 초고속 완료율'],
    '40명 도달 ~ +8일 (활성기)': [
        f"{g_mean_h:.1f}시간 ({g_mean_d:.2f}일)",
        f"{g_med_h:.1f}시간 ({g_med_d:.2f}일)",
        f"{g_p24:.1f}%",
        f"{g_p3:.1f}%"
    ],
    '40명 도달 +8일 이후 (성숙기)': [
        f"{a_mean_h:.1f}시간 ({a_mean_d:.2f}일)",
        f"{a_med_h:.1f}시간 ({a_med_d:.2f}일)",
        f"{a_p24:.1f}%",
        f"{a_p3:.1f}%"
    ],
    '전·후 차이 (변화율)': [
        f"+{a_mean_h-g_mean_h:.1f}시간 (2.7배 지연)",
        f"+{a_med_h-g_med_h:.1f}시간 (4.1배 지연)",
        f"{a_p24-g_p24:.1f}%p",
        f"{a_p3-g_p3:.1f}%p"
    ]
})
display(cycle_summary_table)
